                  "if (pm.response.code === 200) {\r\n\r\n    pm.test(\"Booking found with correct details\", function () {\r\n\r\n        const response = pm.response.json();\r\n\r\n        pm.expect(response.firstname).to.eql(\"Sally\");\r\n        pm.expect(response.lastname).to.eql(\"Brown\");\r\n        pm.expect(response.totalprice).to.eql(111);\r\n        pm.expect(response.depositpaid).to.eql(true);\r\n\r\n        pm.expect(response.bookingdates.checkin).to.eql(\"2013-02-23\");\r\n        pm.expect(response.bookingdates.checkout).to.eql(\"2014-10-23\");\r\n\r\n        pm.expect(response.additionalneeds).to.eql(\"Breakfast\");\r\n    });\r\n\r\n} else if (pm.response.code === 404) {\r\n\r\n    pm.test(\"Booking not found\", function () {\r\n        pm.expect(pm.response.code).to.eql(404);\r\n    });\r\n\r\n} else {\r\n\r\n    pm.test(\"Unexpected response\", function () {\r\n        pm.expect.fail(\"Unexpected status code: \" + pm.response.code);\r\n    });\r\n}"
                ]
